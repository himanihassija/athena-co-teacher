# ─── Secrets ─────────────────────────────────────────────────────────────────
#
# apps/web/.env.local and apps/orchestrator/.env both hold
# NEXT_AGORA_APP_CERTIFICATE, which signs every RTC and RTM token for the
# project. Anyone with it can mint tokens and join your channels, so these must
# never be committed. Both are regenerated on any machine with:
#
#   agora project use athena-echosphere
#   agora project env write apps/web/.env.local
#
# Patterns without a slash match at every depth, so these cover both apps.
.env
.env.*
*.env

# Template files carry no values and are meant to be committed.
!env.local.example
!*.example
!.env.example

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
jspm_packages/
.pnp.*

# A literal directory named "~" at repo root — an unexpanded-tilde artifact
# from an install script, containing its own nested git repo
# (~/agora-skills). Not meant to be committed; git itself refuses to embed a
# nested repo's contents as plain files, only a broken gitlink reference.
/~/

# ─── Build output ────────────────────────────────────────────────────────────
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# ─── Caches ──────────────────────────────────────────────────────────────────
.turbo/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/

# ─── Python (apps/python-demo) ───────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ─── Test artefacts ──────────────────────────────────────────────────────────
#
# The Playwright suites in apps/web/scripts write here when a run fails.
# The scripts themselves are source and are committed.
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
*.lcov
.nyc_output/

# Generated speech fixtures for the microphone test. Regenerate with:
#   say -o speech.aiff "…" && afconvert -f WAVE -d LEI16@48000 -c 1 speech.aiff speech.wav
*.wav
*.aiff

# ─── Deployment ──────────────────────────────────────────────────────────────
.vercel/
.serverless/

# ─── Logs and runtime noise ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.seed
*.pid.lock
.node_repl_history
*.tgz

# ─── Editors and OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Note: .agora/project.json is deliberately NOT ignored. It records which Agora
# project this checkout is bound to — an id and a name, no credentials — and
# committing it means a teammate's `agora project env write` targets the right
# project without being told which one.
.vercel
